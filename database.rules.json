{
  "rules": {
    "stats": {
      "totalVisits": {
        ".read": true,
        ".write": "auth != null && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
      }
    },
    "presence": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.isNumber()"
      }
    }
  }
}
